# Environment Variables
# Copy this file to .env and fill in your values.
# Most configuration now uses centralized defaults in config.py/constants.ts

# ── API Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Model ─────────────────────────────────────────────────────────────────────
# Path to the best checkpoint (relative to project root)
# Default: checkpoints/hybrid_best.pth
CHECKPOINT_PATH=checkpoints/hybrid_best.pth

# Device for model inference (cuda/cpu)
# Default: auto-detect CUDA availability
DEVICE=cuda

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
AUDIT_LOG_PATH=logs/audit.jsonl

# ── Safety thresholds ─────────────────────────────────────────────────────────
# Default: 0.5 (50% confidence threshold)
LOW_CONFIDENCE_THRESHOLD=0.5
# Default: 0.15 (15% uncertainty threshold)
UNCERTAINTY_THRESHOLD=0.15

# ── CORS Configuration ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Default: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── XAI Configuration ─────────────────────────────────────────────────────────
# Number of MC Dropout samples for uncertainty estimation
# Default: 30
MC_DROPOUT_SAMPLES=30
